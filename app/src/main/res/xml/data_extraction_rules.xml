<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="usage.db" />
        <include domain="sharedpref" path="prefs.xml" />
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="usage.db" />
        <include domain="sharedpref" path="prefs.xml" />
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
