<?xml version="1.0" encoding="utf-8"?>
<!-- The MiFi and router only speak plain http on the local network, at whatever
     gateway address the Wi-Fi hands out. Everything else (GitHub) is https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
