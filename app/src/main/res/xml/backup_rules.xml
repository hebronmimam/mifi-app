<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Only what is listed is backed up: the usage history and
     settings. The stored device password (secrets.xml) is never listed, so it never
     leaves the phone; its key lives in the Keystore anyway. -->
<full-backup-content>
    <include domain="database" path="usage.db" />
    <include domain="sharedpref" path="prefs.xml" />
</full-backup-content>
